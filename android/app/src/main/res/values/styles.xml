<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Texpod" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.Texpod.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/pill_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

</resources>
