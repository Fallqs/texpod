<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_texpod" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reader_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/reader_card"
            android:elevation="6dp"
            android:padding="12dp">

            <com.crossmux.textplayer.preview.ReaderPreviewView
                android:id="@+id/reader_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/preview_hint" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_texpod" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textColor="@color/ink"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_body"
                    android:textColor="@color/secondary_ink"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/sample_button"
                    style="@style/Widget.Texpod.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/pill_accent"
                    android:minHeight="48dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/try_sample" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/paper"
                android:padding="12dp"
                android:text="@string/preview_error"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/live_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/capture_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ready_title"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/clear_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/capture_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/ready_detail"
            android:textColor="@color/secondary_ink"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previous_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/button_circle"
                android:contentDescription="@string/previous_page"
                android:src="@drawable/ic_previous" />

            <TextView
                android:id="@+id/page_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/no_pages"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/next_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/button_circle"
                android:contentDescription="@string/next_page"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <Button
            android:id="@+id/reader_button"
            style="@style/Widget.Texpod.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:drawableStart="@drawable/ic_bluetooth"
            android:drawablePadding="10dp"
            android:text="@string/connect_reader" />

        <TextView
            android:id="@+id/reader_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/reader_open_tip"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reader_profile_toggle"
            style="@style/Widget.Texpod.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/reader_profile_open" />

        <TextView
            android:id="@+id/reader_profile_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/reader_card"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/reader_reinstall_font"
            style="@style/Widget.Texpod.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/reader_reinstall_font"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reader_traffic_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/reader_card"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/reader_traffic_history"
            style="@style/Widget.Texpod.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reader_traffic_history"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
